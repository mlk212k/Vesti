# Copie ce fichier vers .env.local et renseigne les valeurs du projet Supabase.
# (Tableau de bord Supabase > Project Settings > API)

# --- Supabase ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://TON-PROJET.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="TA-CLE-ANON-PUBLIQUE"

# Clé service_role : SERVEUR UNIQUEMENT. Elle ignore la RLS.
# Ne jamais la préfixer NEXT_PUBLIC_, ne jamais l'importer dans un composant
# client. Elle sert à trois choses seulement :
#   - créer/supprimer les comptes des commerciaux (l'admin crée les comptes) ;
#   - fixer le rôle d'un profil ;
#   - compter les tentatives de connexion ratées (migration 0005).
SUPABASE_SERVICE_ROLE_KEY="TA-CLE-SERVICE-ROLE"

# --- Application ---------------------------------------------------------
# URL publique de l'app, sans slash final. Sert aux liens envoyés par email
# (réinitialisation de mot de passe).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Nom affiché dans l'interface et l'onglet du navigateur.
NEXT_PUBLIC_APP_NAME="ARENA"
