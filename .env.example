# --- Application ---------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Vesti

# --- Supabase ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role : serveur uniquement (webhook Stripe, écritures d'analyses).
# Ne doit JAMAIS être préfixée NEXT_PUBLIC_ ni importée dans un composant client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude --------------------------------------------------------------
ANTHROPIC_API_KEY=
# Uniquement si ta clé est « liée à une identité » : l'API exige alors de
# préciser l'espace de travail (erreur « anthropic-workspace-id is required »).
# Une clé de console classique n'en a pas besoin — laisse vide.
ANTHROPIC_WORKSPACE_ID=

# --- Stripe --------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STYLISTE=

# --- Administration ------------------------------------------------------
# Emails autorisés à accéder à /admin, séparés par des virgules.
# Vide = personne n'y a accès.
ADMIN_EMAILS=
