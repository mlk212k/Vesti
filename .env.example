# --- Application ---------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Vesti

# --- Supabase ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role : serveur uniquement (webhook Stripe, écritures d'analyses).
# Ne doit JAMAIS être préfixée NEXT_PUBLIC_ ni importée dans un composant client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude --------------------------------------------------------------
ANTHROPIC_API_KEY=
# Uniquement si ta clé est « liée à une identité » : l'API exige alors de
# préciser l'espace de travail (erreur « anthropic-workspace-id is required »).
# Une clé de console classique n'en a pas besoin — laisse vide.
ANTHROPIC_WORKSPACE_ID=

# --- Stripe --------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STYLISTE=

# --- Affiliation (plan Styliste) -----------------------------------------
# Rémunère les liens produits recommandés. Les DEUX variables sont
# nécessaires : tant que l'une manque, chaque lien sort inchangé et rien ne
# change pour personne.
#
# 1. NEXT_PUBLIC_AWIN_AFFILIATE_ID : ton identifiant éditeur Awin, unique pour
#    ton compte. Il se trouve en haut du tableau de bord Awin.
# 2. NEXT_PUBLIC_AWIN_MERCHANTS : la table « domaine:identifiant », une entrée
#    par programme ACCEPTÉ. L'identifiant (« advertiser ID » / awinmid) est
#    propre à chaque marchand ET à chaque pays — il se lit dans la fiche du
#    programme, une fois ta candidature validée.
#
# ⚠️ N'invente jamais ces numéros. Un identifiant faux ne provoque pas
# d'erreur visible : il produit un lien qui redirige mal ou qui crédite
# quelqu'un d'autre, et ça ne se découvre qu'en constatant qu'aucune
# commission n'est jamais tombée. Un marchand absent de la table garde un lien
# direct, non rémunéré — ce qui est le bon comportement par défaut.
#
# Exemple de forme (chiffres fictifs, à remplacer par les tiens) :
# NEXT_PUBLIC_AWIN_MERCHANTS=asos.com:1234,hm.com:5678,zalando.fr:9012
NEXT_PUBLIC_AWIN_AFFILIATE_ID=
NEXT_PUBLIC_AWIN_MERCHANTS=

# --- Administration ------------------------------------------------------
# Emails autorisés à accéder à /admin, séparés par des virgules.
# Vide = personne n'y a accès.
ADMIN_EMAILS=
