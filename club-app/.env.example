# Copy to .env.local and fill in real values.
# Values come from your Supabase project settings > API.

NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-PUBLISHABLE-KEY"

# Public URL of this app (used for auth callbacks). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Human-friendly name of the club, shown in the UI.
NEXT_PUBLIC_CLUB_NAME="US Guentrange"

# Web Push private key (server-only secret — never commit a real value).
# Pair generated with `npx web-push generate-vapid-keys`; the matching
# public key is hardcoded in lib/push/config.ts (safe, it's sent to every
# browser anyway).
VAPID_PRIVATE_KEY="YOUR-VAPID-PRIVATE-KEY"

# Shared secret Vercel Cron sends back as "Authorization: Bearer <value>"
# when it calls /api/cron/*. The training-reminders route also forwards
# this same value to the cron_* Supabase RPCs (see migration 0010) as
# their own auth check, so no service_role key is needed at all — set
# the matching value in Supabase too: insert into public.app_secrets
# (key, value) values ('cron_secret', '<this value>'). Any random string
# works; never commit a real value here.
CRON_SECRET="YOUR-CRON-SECRET"
